* text=auto
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.robin text eol=crlf
*.md text eol=lf
.githooks/* text eol=lf
*.drawio text eol=lf
*.mp4 binary
*.xlsx binary
*.docx binary
# KB Robin de terceiros (reference/vendor/): bytes exatos, travados por sha256
# em manifest.json. Sem conversão de EOL, senão o hash muda no checkout.
reference/vendor/pad-robin-kb/** -text
