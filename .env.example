# URL base da IAra, compatível com OpenAI; deve terminar em /v1.
IARA_BASE_URL=
# Chave fornecida pelo time responsável; nunca versionar o valor real.
IARA_API_KEY=
# Identificador real do modelo da IAra; confirmar com o time responsável.
IARA_MODEL=
# Opcionais, só para o harness refold (API Anthropic Messages em {IARA_BASE_URL}/messages):
# REFOLD_AUTH=x-api-key   (ou bearer, se o proxy exigir o cabeçalho Authorization no esquema Bearer)
# REFOLD_MAX_TOKENS=8192
